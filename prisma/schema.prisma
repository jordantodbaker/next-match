generator client {
  provider = "prisma-client-js"
  //output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SafetyNarrative {
  id             Int             @id @default(autoincrement())
  user           User?           @relation(fields: [userId], references: [id])
  userId         Int?
  companyAccount CompanyAccount? @relation(fields: [companyId], references: [id])
  companyId      Int?
  narrative      String?
  updatedAt      DateTime?       @updatedAt
  authorized     Boolean?        @default(false)
}

model Narrative {
  id              Int             @id @default(autoincrement())
  user            User?           @relation(fields: [userId], references: [id])
  userId          Int?
  companyAccount  CompanyAccount? @relation(fields: [companyId], references: [id])
  companyId       Int?
  narrative       String
  narrativeType   NarrativeType   @relation(fields: [narrativeTypeId], references: [id])
  narrativeTypeId Int
  updatedAt       DateTime?       @updatedAt
  authorized      Boolean         @default(false)
}

model NarrativeType {
  id        Int         @id @default(autoincrement())
  type      String
  narrative Narrative[]
}

model CompanyAccount {
  id                   Int                   @id @default(autoincrement())
  name                 String
  companyCode          String                @unique
  powerBiUrl           String?
  users                User[]
  safetyNarratives     SafetyNarrative[]
  narratives           Narrative[]
  projects             Project[]
  workforcePlans       WorkforcePlan[]
  workforcePlansLegacy WorkforcePlanLegacy[]
  roles                Role[]
}

model User {
  id                Int               @id @default(autoincrement())
  name              String
  email             String            @unique
  address           String?
  clerkId           String?           @unique
  securityRole      SecurityRole      @default(USER)
  companyAccount    CompanyAccount    @relation(fields: [companyId], references: [id])
  companyId         Int
  selectedCompanyId Int?
  selectedProjectId Int?
  hasTakenWFPTour   Boolean           @default(false)
  safetyNarratives  SafetyNarrative[]
  narratives        Narrative[]
}

model Project {
  id                   Int                   @id @default(autoincrement())
  name                 String
  code                 String                @unique // Remove @unique after legacy ?
  companyAccounts      CompanyAccount[] //@relation(fields: [companyId], references: [id])
  workforcePlans       WorkforcePlan[]
  workforcePlansLegacy WorkforcePlanLegacy[]
}

model WorkforcePlan {
  id             Int            @id @default(autoincrement())
  companyAccount CompanyAccount @relation(fields: [companyId], references: [id])
  companyId      Int
  projectId      Int
  project        Project        @relation(fields: [projectId], references: [id])
  date           DateTime
  dayCount       Int
  nightCount     Int
  roleId         Int
  role           Role           @relation(fields: [roleId], references: [id])
}

model WorkforcePlanLegacy {
  id                Int            @id @default(autoincrement())
  area              String?
  roleName          String
  remainingHours    Int?
  plannedHours      Int?
  varianceHours     Int?
  shiftHours        Int?
  plannedShiftHours Int?
  workerDays        Int?
  shift             String?
  date              DateTime
  headCount         Int?
  projectCode       String
  companyCode       String
  project           Project        @relation(fields: [projectCode], references: [code])
  role              Role           @relation(fields: [roleName], references: [name])
  companyAccount    CompanyAccount @relation(fields: [companyCode], references: [companyCode])
}

model Role {
  id                   Int                   @id @default(autoincrement())
  code                 String?
  name                 String                @unique //Remove @unique after legacy?
  description          String?
  categoryId           Int
  category             RoleCategory          @relation(fields: [categoryId], references: [id])
  workforcePlans       WorkforcePlan[]
  workforcePlansLegacy WorkforcePlanLegacy[]
  companyAccounts      CompanyAccount[]
}

model RoleCategory {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  isDirect    Boolean @default(true)
  roles       Role[]
}

enum SecurityRole {
  USER
  ADMIN
}

enum Shift {
  Day
  Night
}
