generator client {
  provider = "prisma-client-js"
  //output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  //user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model SafetyNarrative {
  id             Int             @id @default(autoincrement())
  user           User?           @relation(fields: [userId], references: [id])
  userId         Int?
  companyAccount CompanyAccount? @relation(fields: [companyId], references: [id])
  companyId      Int?
  narrative      String?
  updatedAt      DateTime?       @updatedAt
  authorized     Boolean?        @default(false)
}

model Narrative {
  id              Int             @id @default(autoincrement())
  user            User?           @relation(fields: [userId], references: [id])
  userId          Int?
  companyAccount  CompanyAccount? @relation(fields: [companyId], references: [id])
  companyId       Int?
  narrative       String
  narrativeType   NarrativeType   @relation(fields: [narrativeTypeId], references: [id])
  narrativeTypeId Int
  updatedAt       DateTime?       @updatedAt
  authorized      Boolean         @default(false)
}

model NarrativeType {
  id        Int         @id @default(autoincrement())
  type      String
  narrative Narrative[]
}

model CompanyAccount {
  id               Int                      @id @default(autoincrement())
  name             String
  companyCode      String
  users            User[]
  safetyNarratives SafetyNarrative[]
  narratives       Narrative[]
  projects         Project[]
  workforcePlans   WorkforcePlan[]
  roles            Role[]
  headcounts  Headcount[]
}

model User {
  id                Int               @id @default(autoincrement())
  name              String?
  email             String            @unique
  emailVerified     DateTime?
  passwordHash      String
  image             String?
  //accountId        String
  securityRole      SecurityRole      @default(USER)
  //accounts         Account[]
  companyAccount    CompanyAccount    @relation(fields: [companyId], references: [id])
  companyId         Int
  selectedCompanyId Int?
  selectedProjectId Int?
  safetyNarratives  SafetyNarrative[]
  narratives        Narrative[]
  headcounts  Headcount[]
}

model Project {
  id              Int              @id @default(autoincrement())
  name            String
  code            String
  companyAccounts CompanyAccount[] //@relation(fields: [companyId], references: [id])
  workforcePlans  WorkforcePlan[]
  headcounts  Headcount[]
}

model WorkforcePlan {
  id             Int            @id @default(autoincrement())
  companyAccount CompanyAccount @relation(fields: [companyId], references: [id])
  companyId      Int
  projectId      Int
  project        Project        @relation(fields: [projectId], references: [id])
  date           DateTime
  dayCount       Int
  nightCount     Int
  roleId         Int
  role           Role           @relation(fields: [roleId], references: [id])
}

model Role {
  id              Int                      @id @default(autoincrement())
  code            String
  name            String
  workforcePlans  WorkforcePlan[]
  isDirect        Boolean                  @default(true)
  companyAccounts CompanyAccount[]
  headcounts  Headcount[]
}

model Headcount {
  id Int @id @default(autoincrement())
  dayCount Int
  nightCount Int
  date DateTime
  role Role @relation(fields: [roleId], references: [id])
  roleId Int
  company CompanyAccount @relation(fields: [companyId], references: [id])
  companyId Int
  user    User @relation(fields: [userId], references: [id])
  userId Int
  project Project @relation(fields: [projectId], references: [id])
  projectId Int
}

enum SecurityRole {
  USER
  ADMIN
}
